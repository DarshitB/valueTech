{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon index.js",
    "sandbox": "cross-env NODE_ENV=sandbox node index.js",
    "start": "cross-env NODE_ENV=production node index.js",
    "migrate:dev": "knex migrate:latest --env development",
    "migrate:sandbox": "knex migrate:latest --env sandbox",
    "migrate:prod": "knex migrate:latest --env production",
    "migrate:down:dev": "knex migrate:down --env development",
    "migrate:down:prod": "knex migrate:down --env production",
    "migrate:down:sandbox": "knex migrate:down --env sandbox",
    "seed:dev": "knex seed:run --env development",
    "seed:sandbox": "knex seed:run --env sandbox",
    "seed:prod": "knex seed:run --env production",
    "seed:down:dev": "knex seed:rollback --env development",
    "seed:down:prod": "knex seed:rollback --env production",
    "seed:down:sandbox": "knex seed:rollback --env sandbox"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mime-types": "^3.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.14.0",
    "pg": "^8.16.3",
    "puppeteer": "^24.19.0",
    "sequelize": "^6.37.7",
    "sharp": "^0.33.5",
    "ua-parser-js": "^2.0.4",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
